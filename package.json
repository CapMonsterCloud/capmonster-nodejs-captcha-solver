{
  "name": "@zennolab_com/capmonstercloud-client",
  "version": "2.9.4",
  "description": "Official CapMonster Cloud Node.js and TypeScript SDK: captcha solver & captcha bypass for reCAPTCHA, Cloudflare Turnstile, DataDome and GeeTest. A 2captcha and capsolver alternative.",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "default": "./dist/esm/index.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/CapMonsterCloud/capmonster-nodejs-captcha-solver#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CapMonsterCloud/capmonster-nodejs-captcha-solver.git"
  },
  "bugs": {
    "url": "https://github.com/CapMonsterCloud/capmonster-nodejs-captcha-solver/issues"
  },
  "keywords": [
    "CapMonster",
    "CapMonster Cloud",
    "captcha",
    "captcha-solver",
    "captcha-bypass",
    "recaptcha",
    "cloudflare-turnstile",
    "geetest",
    "datadome",
    "web-scraping",
    "puppeteer",
    "playwright",
    "typescript",
    "2captcha-alternative",
    "capsolver-alternative"
  ],
  "scripts": {
    "build": "node js-rimraf.js && npx tsc && npx tsc -p tsconfig.esm.json && node js-fix-esm-imports.js && node -e \"require('fs').writeFileSync('dist/esm/package.json', JSON.stringify({ type: 'module' }, null, 2))\"",
    "prepare": "npm run build",
    "test": "jest",
    "test-unit": "jest -c jest.config.unit.js",
    "test-integr": "jest -c jest.config.integration.js",
    "self-verify": "node tools/self-verify/run.js",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "test-types": "tsc --noEmit --strict --skipLibCheck --target ES2020 --module NodeNext --moduleResolution NodeNext tools/self-verify/type-contracts.mts",
    "test-readme": "node tools/self-verify/run-readme-examples.js",
    "test-modules": "node tools/self-verify/run-module-matrix.js"
  },
  "author": {
    "name": "CapMonster Cloud",
    "email": "support@capmonster.cloud",
    "url": "https://capmonster.cloud/en/"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/debug": "^4.1.7",
    "@types/jest": "^29.0.0",
    "@types/node": "^18.7.9",
    "@typescript-eslint/eslint-plugin": "^5.33.1",
    "@typescript-eslint/parser": "^5.33.1",
    "eslint": "^8.22.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "^29.6.2",
    "prettier": "^2.7.1",
    "ts-jest": "^29.1.1",
    "typescript": "^4.7.4"
  },
  "dependencies": {
    "debug": "^4.3.4"
  },
  "overrides": {
    "minimatch": "^10.1.1",
    "brace-expansion": "^5.0.8"
  }
}
